//@version=6
// =============================================================================
//  Al Brooks Micro Trendlines & Trend Channels
// -----------------------------------------------------------------------------
//  Concept (Al Brooks price action):
//    In a trend, price moves in pushes. You draw a MICRO TRENDLINE on the trend
//    side, touching the last few candles of the push:
//       - Bull push : line under the rising LOWS   (higher lows)
//       - Bear push : line over  the falling HIGHS  (lower highs)
//    As a trend matures each successive line tends to get SHALLOWER (flatter).
//    Each flattening step means counter-trend traders are being trapped. When a
//    shallow line finally BREAKS, those traders are flushed -> fuel for the
//    bigger reversal / strong continuation.
//
//  This version draws lines from CONSECUTIVE CANDLES (the last 2-3 bars of the
//  push), not from confirmed pivots. That is what lets it catch steady one-way
//  pushes — e.g. a grind down off the 20 EMA — where no local pivot ever forms.
//
//  What it does:
//    1. Rides a micro line along the stepping lows (bull) / highs (bear).
//    2. Draws a parallel TREND CHANNEL line on the opposite extreme.
//    3. FREEZES (stops + recolors) a line when price breaks it, but keeps it on
//       the chart so you can see the whole sequence of pushes.
//    4. Tracks the SLOPE of each line. After N successively shallower lines, a
//       break prints a marker and fires an alert: "look for a bigger move".
// =============================================================================

indicator("Al Brooks Micro Trendlines & Channels", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ----------------------------- Inputs ---------------------------------------
grpTrend   = "Trend Detection"
emaLen     = input.int(20,  "Trend EMA length",            minval = 1,  group = grpTrend)
useEma     = input.bool(false, "Require EMA slope agreement", group = grpTrend, tooltip = "OFF (default): draw a line on any qualifying push. ON: only draw bear lines while EMA slopes down and bull lines while EMA slopes up.")

grpLine    = "Micro Trendlines"
minBars     = input.int(2, "Candles to start a line (2 or 3)", minval = 2, maxval = 3, group = grpLine, tooltip = "A micro line starts after this many consecutive stepping candles (lower highs for bear, higher lows for bull).")
allowEqual  = input.bool(true, "Allow equal highs/lows as a step", group = grpLine, tooltip = "Treat an equal high/low as a valid step (common in fast pushes). Off = strictly lower-high / higher-low.")
extendLine  = input.bool(true, "Extend active line forward", group = grpLine)
breakSrc    = input.string("close", "Break confirmation", options = ["close","wick"], group = grpLine, tooltip = "close = line breaks on a close beyond it. wick = any penetration breaks it.")
minSlopeTk  = input.int(1, "Min bars a line must survive to count", minval = 1, maxval = 10, group = grpLine, tooltip = "Ignore 1-bar noise: a line must last at least this many bars before a break is treated as a real break for the flattening sequence.")

grpChan    = "Trend Channel"
showChannel = input.bool(true, "Show parallel channel line", group = grpChan)

grpFlat    = "Flattening Signal"
flatSteps   = input.int(2, "Consecutive shallower lines to flag", minval = 1, maxval = 5, group = grpFlat, tooltip = "How many successively flatter micro lines before a break is treated as a bigger-move signal.")
flatTol     = input.float(0.0, "Flattening tolerance", step = 0.01, group = grpFlat, tooltip = "A line counts as 'shallower' if |slope| < |prev slope| * (1 - tolerance). 0 = strictly flatter.")

grpColor   = "Colors"
colBull    = input.color(color.new(color.teal,   0),  "Bull micro line",      group = grpColor)
colBear    = input.color(color.new(color.red,    0),  "Bear micro line",      group = grpColor)
colBroken  = input.color(color.new(color.gray,   40), "Broken (frozen) line", group = grpColor)
colChan    = input.color(color.new(color.blue,   50), "Channel line",         group = grpColor)
colSignal  = input.color(color.new(color.orange, 0),  "Flattening signal",    group = grpColor)

// ----------------------------- Trend context --------------------------------
ema     = ta.ema(close, emaLen)
emaUp   = ema > ema[1]
emaDown = ema < ema[1]
emaOkBull = not useEma or emaUp
emaOkBear = not useEma or emaDown

// ----------------------------- Step detection --------------------------------
// A bear "step" = this bar's high <= previous bar's high (price stepping down).
// A bull "step" = this bar's low  >= previous bar's low  (price stepping up).
bool stepDown = not na(high[1]) and (allowEqual ? (high <= high[1]) : (high < high[1]))
bool stepUp   = not na(low[1])  and (allowEqual ? (low  >= low[1])  : (low  > low[1]))

// Track each run's length AND its starting anchor (bar + price), without using a
// dynamic historical offset (which can exceed the series buffer on realtime bars).
var int   downRun     = 0    // consecutive step-down bars ending at current bar
var int   upRun       = 0
var int   downRunBar  = na   // bar_index of the high that started the down-run
var float downRunHigh = na   // that starting high
var int   upRunBar    = na   // bar_index of the low that started the up-run
var float upRunLow    = na   // that starting low

if stepDown
    if downRun == 0
        // run begins: the anchor is the PREVIOUS bar's high (the higher high)
        downRunBar  := bar_index - 1
        downRunHigh := high[1]
    downRun += 1
else
    downRun := 0

if stepUp
    if upRun == 0
        upRunBar := bar_index - 1
        upRunLow := low[1]
    upRun += 1
else
    upRun := 0

// ----------------------------- State -----------------------------------------
var line  activeLine   = na      // currently extending micro trendline
var line  activeChan   = na      // currently extending channel line
var int   lineDir      = 0       // 1 = bull line (under lows), -1 = bear line (over highs)
var float lineSlope    = na      // slope (price per bar) of the active line
var float lineB        = na      // y value of the line at x = anchorBar
var int   anchorBar    = na      // bar_index used as the slope reference (the 2nd touch)
var int   startBar     = na      // bar_index where the line began (1st touch)
var float startY       = na      // price at the start touch
var int   lineAge      = 0       // bars since this line was created
var float prevAbsSlope = na      // |slope| of the previously broken line (same dir)
var int   flatCount    = 0       // how many successive lines have been shallower
var float chanGap      = na      // channel offset for the active line (reset per line)

f_slope(x1, y1, x2, y2) => (x2 == x1) ? na : (y2 - y1) / (x2 - x1)
f_lineY(bx) => na(lineSlope) ? na : lineB + lineSlope * (bx - anchorBar)

// Freeze the active line/channel in place (keep them on the chart).
f_freeze() =>
    if not na(activeLine)
        line.set_color(activeLine, colBroken)
        line.set_style(activeLine, line.style_dotted)
        line.set_extend(activeLine, extend.none)
    if not na(activeChan)
        line.set_color(activeChan, colBroken)
        line.set_extend(activeChan, extend.none)

// ----------------------------- Break detection -------------------------------
// Evaluate a break against the CURRENT active line before we (possibly) start a
// new one on this bar.
float yNow = f_lineY(bar_index)
bool brokeBull = lineDir == 1  and not na(yNow) and (breakSrc == "close" ? close < yNow : low  < yNow)
bool brokeBear = lineDir == -1 and not na(yNow) and (breakSrc == "close" ? close > yNow : high > yNow)
bool broke     = (brokeBull or brokeBear) and lineAge >= minSlopeTk

bool signalFired = false
if broke and not na(activeLine)
    float absSlope = math.abs(lineSlope)
    bool shallower = na(prevAbsSlope) ? false : absSlope < prevAbsSlope * (1.0 - flatTol)
    flatCount   := shallower ? flatCount + 1 : 0
    prevAbsSlope := absSlope

    line.set_xy2(activeLine, bar_index, yNow)
    f_freeze()

    if flatCount >= flatSteps
        signalFired := true
        label.new(bar_index, lineDir == 1 ? low : high, text = (lineDir == 1 ? "⚠ Bull line flush" : "⚠ Bear line flush") + "\nlines flattening → look for bigger move", style = lineDir == 1 ? label.style_label_up : label.style_label_down, color = colSignal, textcolor = color.white, size = size.small)
        flatCount := 0

    activeLine := na
    activeChan := na
    lineSlope  := na
    lineDir    := 0
    lineAge    := 0

// ----------------------------- Start a new line ------------------------------
// If we have no active line and enough consecutive steps, start one touching the
// first and current bar of the run. Bear rides highs; bull rides lows.
if na(activeLine)
    if downRun >= (minBars - 1) and emaOkBear
        float sl = f_slope(downRunBar, downRunHigh, bar_index, high)
        if not na(sl)
            anchorBar := bar_index
            lineB     := high
            lineSlope := sl
            lineDir   := -1
            startBar  := downRunBar
            startY    := downRunHigh
            lineAge   := 0
            chanGap   := na
            activeLine := line.new(downRunBar, downRunHigh, bar_index, high, xloc = xloc.bar_index, color = colBear, width = 2, extend = extendLine ? extend.right : extend.none)
    else if upRun >= (minBars - 1) and emaOkBull
        float sl = f_slope(upRunBar, upRunLow, bar_index, low)
        if not na(sl)
            anchorBar := bar_index
            lineB     := low
            lineSlope := sl
            lineDir   := 1
            startBar  := upRunBar
            startY    := upRunLow
            lineAge   := 0
            chanGap   := na
            activeLine := line.new(upRunBar, upRunLow, bar_index, low, xloc = xloc.bar_index, color = colBull, width = 2, extend = extendLine ? extend.right : extend.none)

// ----------------------------- Maintain active line --------------------------
// Re-anchor the second touch to the newest qualifying high/low so the line keeps
// riding the push, then extend it to the current bar.
if not na(activeLine)
    lineAge += 1
    if lineDir == -1 and stepDown
        // pivot the line onto the new lower high
        lineSlope := f_slope(startBar, startY, bar_index, high)
        anchorBar := bar_index
        lineB     := high
        line.set_xy1(activeLine, startBar, startY)
        line.set_xy2(activeLine, bar_index, high)
    else if lineDir == 1 and stepUp
        lineSlope := f_slope(startBar, startY, bar_index, low)
        anchorBar := bar_index
        lineB     := low
        line.set_xy1(activeLine, startBar, startY)
        line.set_xy2(activeLine, bar_index, low)
    else if extendLine
        // no new touch this bar: just project the existing slope forward
        line.set_xy2(activeLine, bar_index, f_lineY(bar_index))

// ----------------------------- Channel line ----------------------------------
if showChannel and not na(activeLine) and not na(lineSlope)
    float proj   = f_lineY(bar_index)
    float offset = lineDir == 1 ? (high - proj) : (low - proj)
    chanGap := na(chanGap) ? offset : (lineDir == 1 ? math.max(chanGap, offset) : math.min(chanGap, offset))
    float cy1 = lineB + lineSlope * (startBar - anchorBar) + chanGap
    float cy2 = proj + chanGap
    if na(activeChan)
        activeChan := line.new(startBar, cy1, bar_index, cy2, xloc = xloc.bar_index, color = colChan, style = line.style_dashed, extend = extendLine ? extend.right : extend.none)
    else
        line.set_xy1(activeChan, startBar, cy1)
        line.set_xy2(activeChan, bar_index, cy2)

// ----------------------------- Alerts / plot ---------------------------------
plotshape(signalFired, title = "Flattening flush signal", style = shape.triangleup, location = location.belowbar, color = colSignal, size = size.tiny)

alertcondition(brokeBull, title = "Bull micro trendline broken", message = "Bull micro trendline broken")
alertcondition(brokeBear, title = "Bear micro trendline broken", message = "Bear micro trendline broken")
alertcondition(signalFired, title = "Flattening flush (bigger-move)", message = "Micro trendlines flattened then broke — look for a bigger move")
